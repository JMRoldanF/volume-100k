       SEND-RECEIVE-MAP-0007.
               EXEC CICS SEND MAP('ZBAMAP0I')
                         MAPSET('ZBAMAP01')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZBAMAP0I')
                         MAPSET('ZBAMAP01')
                         RESP(WS-RESP)
               END-EXEC.
