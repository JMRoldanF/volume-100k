      *----------------------------------------------------------------*
       FILE-ACCESS-0063.
               EXEC CICS READ FILE('KSDSAG68')
                         INTO(KSDSAG68-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
