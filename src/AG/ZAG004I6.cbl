               EXEC CICS SEND MAP('ZAGMAP0I')
                         MAPSET('ZAGMAP06')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZAGMAP0I')
                         MAPSET('ZAGMAP06')
                         RESP(WS-RESP)
               END-EXEC.
