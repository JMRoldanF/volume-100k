       MAINLINE SECTION.
               INITIALIZE WS-HEADER.
               OPEN INPUT  INPUT-FILE.
               OPEN OUTPUT OUTPUT-FILE.
               OPEN OUTPUT REPORT-FILE.
               PERFORM CALL-ZBR01R9S-001.
               PERFORM CALL-ZBR01U0R-002.
               PERFORM RESOLVE-EXCESS-0001.
               PERFORM AUDIT-MODEL-0002.
               PERFORM FORMAT-EQUITIES-0003.
               PERFORM REFRESH-VALUE-0004.
               PERFORM CHECK-HOUSE-TYPE-0005.
               PERFORM COMPUTE-TERM-0006.
               PERFORM RECONCILE-MANAGED-FUND-0007.
               PERFORM EXPAND-ROOF-TYPE-0008.
               PERFORM DERIVE-NCD-YEARS-0009.
               PERFORM UNTIL WS-EOF
                  READ INPUT-FILE
                       AT END MOVE 'Y' TO WS-EOF-FLAG
                  END-READ
                  IF NOT WS-EOF
                     WRITE OUT-REC FROM IN-REC
                     ADD 1 TO WS-ENTRY-COUNT
                  END-IF
               END-PERFORM.
               CLOSE INPUT-FILE OUTPUT-FILE REPORT-FILE.
               GOBACK.
