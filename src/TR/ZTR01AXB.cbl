       FILE-ACCESS-0060.
               EXEC CICS REWRITE FILE('KSDSTR18')
                         FROM(KSDSTR18-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
