       CALL-ZRE00EN5-002.
               EXEC CICS LINK PROGRAM('ZRE00EN5')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZRE00EN5 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
