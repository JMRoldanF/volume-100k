               END-EXEC.
               EXEC SQL OPEN C0009 END-EXEC.
               PERFORM UNTIL SQLCODE NOT = 0
                  EXEC SQL FETCH C0009
                            INTO :HV-POLICY-NUM, :HV-PAYMENT
                  END-EXEC
