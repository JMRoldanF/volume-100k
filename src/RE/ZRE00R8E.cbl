               END-EVALUATE.
      *----------------------------------------------------------------*
       SQL-ACCESS-0009.
               EXEC SQL
                     DECLARE C0009 CURSOR FOR
                     SELECT POLICYNUMBER, PAYMENT
                       FROM GENARE.RISK A
                       JOIN GENARE.CUSTOMER B
                         ON A.CUSTOMERNUMBER = B.CUSTOMERNUMBER
                      WHERE A.EXPIRYDATE > :HV-EXPIRY-DATE
