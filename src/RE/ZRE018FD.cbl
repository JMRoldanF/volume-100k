       FILE-ACCESS-0060.
               EXEC CICS STARTBR FILE('KSDSRE91')
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               PERFORM UNTIL WS-RESP NOT = DFHRESP(NORMAL)
                  EXEC CICS READNEXT FILE('KSDSRE91')
                            INTO(KSDSRE91-REC)
                            RIDFLD(WS-KEY-AREA)
