               EXEC CICS WRITE FILE('KSDSRE70')
                         FROM(KSDSRE70-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
