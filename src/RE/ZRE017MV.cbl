       FILE-ACCESS-0060.
               EXEC CICS STARTBR FILE('KSDSRE70')
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               PERFORM UNTIL WS-RESP NOT = DFHRESP(NORMAL)
