               END-EVALUATE.
      *----------------------------------------------------------------*
       REFRESH-MODEL-0047.
               UNSTRING WS-KEY-CHAR DELIMITED BY '/'
                             INTO WS-KEY-CUSTOMER
                                  WS-KEY-POLICY
               END-UNSTRING.
      *----------------------------------------------------------------*
       SQL-ACCESS-0048.
               EXEC SQL
                     INSERT INTO GENARE.PREMIUM
                            (CUSTOMERNUMBER, POLICYNUMBER,
