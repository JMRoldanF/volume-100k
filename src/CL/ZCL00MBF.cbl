       SQL-ACCESS-0192.
               EXEC SQL
                     DECLARE C0192 CURSOR FOR
                     SELECT POLICYNUMBER, PAYMENT
                       FROM GENACL.CLAIM A
                       JOIN GENACL.CUSTOMER B
