                  MOVE ' NO COMMAREA RECEIVED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
                  EXEC CICS ABEND ABCODE('LGCA')
                            NODUMP END-EXEC
               END-IF.
               MOVE EIBCALEN TO WS-CALEN.
               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZUW01EVB-001.
               PERFORM CALL-ZCU0255O-002.
               PERFORM RECONCILE-EQUITIES-0001.
               PERFORM CHECK-MAKE-0002.
               PERFORM EXPAND-AGENT-CODE-0004.
               PERFORM NORMALISE-PREMIUM-0005.
               PERFORM FILE-ACCESS-0006.
               PERFORM FORMAT-WITH-PROFITS-0007.
               PERFORM REFRESH-MAKE-0008.
               PERFORM FILE-ACCESS-0009.
               PERFORM DERIVE-CC-RATING-0010.
               PERFORM REFRESH-TERM-0011.
               PERFORM FILE-ACCESS-0012.
               PERFORM COMPUTE-MODEL-0013.
               EXEC CICS RETURN END-EXEC.
