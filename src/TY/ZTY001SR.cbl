                         MAPSET('ZTYMAP03')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZTYMAP0I')
                         MAPSET('ZTYMAP03')
                         RESP(WS-RESP)
               END-EXEC.
