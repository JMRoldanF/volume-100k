               PERFORM SEND-RECEIVE-MAP-0014.
               PERFORM VALIDATE-MODEL-0015.
               PERFORM APPLY-EQUITIES-0016.
               PERFORM RESOLVE-STATUS-CODE-0017.
               PERFORM APPLY-STATUS-CODE-0018.
               PERFORM DERIVE-CC-RATING-0019.
               PERFORM EXPAND-BROKER-ID-0020.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZSE00DKP-001.
               EXEC CICS LINK PROGRAM('ZSE00DKP')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZSE00DKP FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZIV00E6Q-002.
               EXEC CICS LINK PROGRAM('ZIV00E6Q')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZIV00E6Q FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZSE001IO-003.
               EXEC CICS XCTL PROGRAM('ZSE001IO')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZSE001IO FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZHO0255M-004.
               EXEC CICS LINK PROGRAM('ZHO0255M')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZHO0255M FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
