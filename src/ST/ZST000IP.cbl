       PROCEDURE DIVISION.
      *----------------------------------------------------------------*
       MAINLINE SECTION.
               INITIALIZE WS-HEADER.
               MOVE EIBTRNID TO WS-TRANSID.
               MOVE EIBTRMID TO WS-TERMID.
               MOVE EIBTASKN TO WS-TASKNUM.
               IF EIBCALEN IS EQUAL TO ZERO
                  MOVE ' NO COMMAREA RECEIVED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
                  EXEC CICS ABEND ABCODE('LGTS')
                            NODUMP END-EXEC
               END-IF.
               MOVE EIBCALEN TO WS-CALEN.
               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZST00CD8-001.
               PERFORM CALL-ZST00DDB-003.
               PERFORM CALL-ZST002X8-004.
               PERFORM CALL-ZHO0255M-005.
               PERFORM EXPAND-TERM-0001.
               PERFORM COMPUTE-TAX-BAND-0002.
               PERFORM APPLY-TAX-BAND-0003.
               PERFORM RECONCILE-CC-RATING-0004.
               PERFORM AUDIT-MAKE-0005.
               PERFORM FORMAT-HOUSE-TYPE-0006.
               PERFORM SEND-RECEIVE-MAP-0007.
               PERFORM RECONCILE-EXCESS-0008.
               PERFORM RECONCILE-VALUE-0009.
               PERFORM VALIDATE-BROKER-ID-0010.
               PERFORM NORMALISE-MAKE-0011.
               PERFORM FORMAT-STATUS-CODE-0012.
               PERFORM DERIVE-MAKE-0013.
               PERFORM SEND-RECEIVE-MAP-0014.
               PERFORM VALIDATE-AGENT-CODE-0015.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZST00CD8-001.
               EXEC CICS LINK PROGRAM('ZST00CD8')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZST00CD8 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZST00HZE-002.
               EXEC CICS LINK PROGRAM('ZST00HZE')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZST00HZE FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
