               EXEC CICS SEND MAP('ZMTMAP8I')
                         MAPSET('ZMTMAP80')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZMTMAP8I')
                         MAPSET('ZMTMAP80')
                         RESP(WS-RESP)
               END-EXEC.
