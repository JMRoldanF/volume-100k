                  EXEC CICS READNEXT FILE('KSDSMT19')
                            INTO(KSDSMT19-REC)
                            RIDFLD(WS-KEY-AREA)
                            RESP(WS-RESP)
                  END-EXEC
               END-PERFORM.
               EXEC CICS ENDBR FILE('KSDSMT19') END-EXEC.
