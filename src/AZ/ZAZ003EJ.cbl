       PROCEDURE DIVISION.
      *----------------------------------------------------------------*
       MAINLINE SECTION.
               INITIALIZE WS-HEADER.
               MOVE EIBTRNID TO WS-TRANSID.
               MOVE EIBTRMID TO WS-TERMID.
               MOVE EIBTASKN TO WS-TASKNUM.
               IF EIBCALEN IS EQUAL TO ZERO
                  MOVE ' NO COMMAREA RECEIVED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
                  EXEC CICS ABEND ABCODE('LGTS')
                            NODUMP END-EXEC
               END-IF.
               MOVE EIBCALEN TO WS-CALEN.
               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZAZ006J1-001.
               PERFORM CALL-ZAZ00DNB-002.
               PERFORM CALL-ZAZ00G8Q-003.
               PERFORM CHECK-EQUITIES-0001.
               PERFORM COMPUTE-MODEL-0002.
               PERFORM RECONCILE-TAX-BAND-0003.
               PERFORM COMPUTE-POSTCODE-0004.
               PERFORM EXPAND-HOUSE-TYPE-0005.
               PERFORM COMPUTE-MODEL-0006.
               PERFORM COMPUTE-ROOF-TYPE-0008.
               PERFORM RESOLVE-MANAGED-FUND-0009.
               PERFORM EXPAND-BEDROOMS-0010.
               PERFORM CHECK-TAX-BAND-0011.
               PERFORM VALIDATE-MANAGED-FUND-0012.
               PERFORM CHECK-POSTCODE-0013.
               PERFORM SEND-RECEIVE-MAP-0014.
               PERFORM DERIVE-MANAGED-FUND-0015.
               PERFORM DERIVE-EXCESS-0016.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZAZ006J1-001.
               MOVE 'ZAZ006J1' TO WS-PROGNAME-8
               EXEC CICS LINK PROGRAM(WS-PROGNAME-8)
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZAZ006J1 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZAZ00DNB-002.
               EXEC CICS LINK PROGRAM('ZAZ00DNB')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZAZ00DNB FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZAZ00G8Q-003.
               MOVE 'ZAZ00G8Q' TO WS-PROGNAME-1
               EXEC CICS LINK PROGRAM(WS-PROGNAME-1)
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZAZ00G8Q FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
