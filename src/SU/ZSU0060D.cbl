       SEND-RECEIVE-MAP-0049.
               EXEC CICS SEND MAP('ZSUMAP0I')
                         MAPSET('ZSUMAP08')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZSUMAP0I')
                         MAPSET('ZSUMAP08')
