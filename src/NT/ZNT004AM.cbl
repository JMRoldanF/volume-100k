       CALL-ZNT00964-001.
               EXEC CICS LINK PROGRAM('ZNT00964')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZNT00964 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
