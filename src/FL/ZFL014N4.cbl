       FILE-ACCESS-0099.
               EXEC CICS WRITE FILE('KSDSFL43')
                         FROM(KSDSFL43-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
