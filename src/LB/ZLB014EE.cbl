                  EXEC CICS READNEXT FILE('KSDSLB42')
                            INTO(KSDSLB42-REC)
                            RIDFLD(WS-KEY-AREA)
                            RESP(WS-RESP)
                  END-EXEC
               END-PERFORM.
               EXEC CICS ENDBR FILE('KSDSLB42') END-EXEC.
