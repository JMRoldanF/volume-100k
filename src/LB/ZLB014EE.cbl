               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZLB01NR2-001.
               PERFORM CALL-ZLB01EIW-002.
               PERFORM VALIDATE-MAKE-0001.
               PERFORM DERIVE-SUM-ASSURED-0002.
               PERFORM FILE-ACCESS-0003.
               PERFORM NORMALISE-AGENT-CODE-0004.
               PERFORM AUDIT-SUM-ASSURED-0005.
               PERFORM FILE-ACCESS-0006.
               PERFORM AUDIT-SUM-ASSURED-0007.
               PERFORM REFRESH-MODEL-0008.
               PERFORM FILE-ACCESS-0009.
               PERFORM NORMALISE-TAX-BAND-0010.
               PERFORM RESOLVE-TERM-0011.
               PERFORM FILE-ACCESS-0012.
               PERFORM AUDIT-WITH-PROFITS-0014.
               PERFORM FILE-ACCESS-0015.
               PERFORM NORMALISE-TAX-BAND-0016.
               PERFORM EXPAND-COLOUR-0017.
               EXEC CICS RETURN END-EXEC.
