      *----------------------------------------------------------------*
       CALL-ZHO00DUH-002.
               EXEC CICS LINK PROGRAM('ZHO00DUH')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZHO00DUH FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
