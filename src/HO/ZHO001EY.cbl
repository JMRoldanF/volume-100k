       CALL-ZSL00AD4-001.
               EXEC CICS LINK PROGRAM('ZSL00AD4')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZSL00AD4 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
