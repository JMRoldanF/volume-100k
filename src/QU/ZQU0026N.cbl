       PROCEDURE DIVISION.
      *----------------------------------------------------------------*
       MAINLINE SECTION.
               INITIALIZE WS-HEADER.
               MOVE EIBTRNID TO WS-TRANSID.
               MOVE EIBTRMID TO WS-TERMID.
               MOVE EIBTASKN TO WS-TASKNUM.
               IF EIBCALEN IS EQUAL TO ZERO
                  MOVE ' NO COMMAREA RECEIVED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
                  EXEC CICS ABEND ABCODE('LGRC')
                            NODUMP END-EXEC
               END-IF.
               MOVE EIBCALEN TO WS-CALEN.
               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZQU009WY-001.
               PERFORM CALL-ZQU00A1O-002.
               PERFORM CALL-ZQU00G6Y-003.
               PERFORM CALL-ZMT0255L-004.
               PERFORM EXPAND-ROOF-TYPE-0001.
               PERFORM COMPUTE-PREMIUM-0002.
               PERFORM AUDIT-ROOF-TYPE-0004.
               PERFORM EXPAND-PREMIUM-0005.
               PERFORM REFRESH-REG-NUMBER-0006.
               PERFORM SEND-RECEIVE-MAP-0007.
               PERFORM FORMAT-NCD-YEARS-0008.
               PERFORM COMPUTE-SUM-ASSURED-0009.
               PERFORM COMPUTE-STATUS-CODE-0010.
               PERFORM AUDIT-EXCESS-0011.
               PERFORM RESOLVE-POSTCODE-0012.
               PERFORM NORMALISE-BROKER-ID-0013.
               PERFORM SEND-RECEIVE-MAP-0014.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZQU009WY-001.
               EXEC CICS LINK PROGRAM('ZQU009WY')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZQU009WY FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZQU00A1O-002.
               EXEC CICS LINK PROGRAM('ZQU00A1O')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZQU00A1O FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZQU00G6Y-003.
               EXEC CICS LINK PROGRAM('ZQU00G6Y')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZQU00G6Y FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
