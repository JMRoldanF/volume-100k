       SEND-RECEIVE-MAP-0014.
               EXEC CICS SEND MAP('ZQUMAP0I')
                         MAPSET('ZQUMAP04')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZQUMAP0I')
                         MAPSET('ZQUMAP04')
                         RESP(WS-RESP)
               END-EXEC.
