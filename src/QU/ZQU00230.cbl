       SEND-RECEIVE-MAP-0007.
               EXEC CICS SEND MAP('ZQUMAP0I')
                         MAPSET('ZQUMAP03')
                         ERASE
                         RESP(WS-RESP)
               END-EXEC.
               EXEC CICS RECEIVE MAP('ZQUMAP0I')
                         MAPSET('ZQUMAP03')
                         RESP(WS-RESP)
