                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZQU00D72 FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
               END-IF.
      *----------------------------------------------------------------*
       CALL-ZQU004S0-004.
               EXEC CICS XCTL PROGRAM('ZQU004S0')
                         COMMAREA(DFHCOMMAREA)
