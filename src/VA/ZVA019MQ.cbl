                  EXEC CICS READNEXT FILE('KSDSVA48')
                            INTO(KSDSVA48-REC)
                            RIDFLD(WS-KEY-AREA)
                            RESP(WS-RESP)
                  END-EXEC
               END-PERFORM.
               EXEC CICS ENDBR FILE('KSDSVA48') END-EXEC.
