       CALL-ZFL00A4A-001.
               EXEC CICS LINK PROGRAM('ZFL00A4A')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZFL00A4A FAILED' TO EM-VARIABLE
