               END-EXEC.
               EXEC CICS RECEIVE MAP('ZSCMAP0I')
                         MAPSET('ZSCMAP04')
                         RESP(WS-RESP)
               END-EXEC.
      *----------------------------------------------------------------*
       VALIDATE-TAX-BAND-0190.
