               PERFORM VALIDATE-PREMIUM-0008.
               PERFORM REFRESH-EXCESS-0009.
               PERFORM RECONCILE-REG-NUMBER-0010.
               PERFORM FORMAT-EXCESS-0011.
               PERFORM AUDIT-PREMIUM-0012.
               PERFORM VALIDATE-EQUITIES-0013.
               PERFORM SEND-RECEIVE-MAP-0014.
               PERFORM RECONCILE-MAKE-0015.
               PERFORM NORMALISE-EXCESS-0016.
               PERFORM RECONCILE-POSTCODE-0017.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZFL00HSK-001.
               EXEC CICS LINK PROGRAM('ZFL00HSK')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
