       CALL-ZTY00CEL-001.
               EXEC CICS LINK PROGRAM('ZTY00CEL')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZTY00CEL FAILED' TO EM-VARIABLE
