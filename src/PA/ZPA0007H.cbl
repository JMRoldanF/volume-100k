       CALL-ZCU00H8E-001.
               EXEC CICS LINK PROGRAM('ZCU00H8E')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZCU00H8E FAILED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
