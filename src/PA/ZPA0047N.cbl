       PROCEDURE DIVISION.
      *----------------------------------------------------------------*
       MAINLINE SECTION.
               INITIALIZE WS-HEADER.
               MOVE EIBTRNID TO WS-TRANSID.
               MOVE EIBTRMID TO WS-TERMID.
               MOVE EIBTASKN TO WS-TASKNUM.
               IF EIBCALEN IS EQUAL TO ZERO
                  MOVE ' NO COMMAREA RECEIVED' TO EM-VARIABLE
                  PERFORM WRITE-ERROR-MESSAGE
                  EXEC CICS ABEND ABCODE('LGRC')
                            NODUMP END-EXEC
               END-IF.
               MOVE EIBCALEN TO WS-CALEN.
               SET WS-ADDR-COMMAREA TO ADDRESS OF DFHCOMMAREA.
               PERFORM CALL-ZPA00CAH-001.
               PERFORM CALL-ZPA00LI5-003.
               PERFORM CALL-ZPA00I4R-004.
               PERFORM CALL-ZPA00DE7-005.
               PERFORM EXPAND-ROOF-TYPE-0001.
               PERFORM CHECK-TERM-0002.
               PERFORM CHECK-POSTCODE-0003.
               PERFORM NORMALISE-MANAGED-FUND-0004.
               PERFORM COMPUTE-NCD-YEARS-0005.
               PERFORM NORMALISE-EXCESS-0006.
               PERFORM SEND-RECEIVE-MAP-0007.
               PERFORM DERIVE-POSTCODE-0008.
               PERFORM VALIDATE-CC-RATING-0009.
               PERFORM AUDIT-BROKER-ID-0010.
               PERFORM NORMALISE-REG-NUMBER-0011.
               PERFORM RECONCILE-HOUSE-TYPE-0012.
               PERFORM EXPAND-EXCESS-0013.
               PERFORM SEND-RECEIVE-MAP-0014.
               EXEC CICS RETURN END-EXEC.
      *----------------------------------------------------------------*
       CALL-ZPA00CAH-001.
               EXEC CICS LINK PROGRAM('ZPA00CAH')
                         COMMAREA(DFHCOMMAREA)
                         LENGTH(WS-CALEN)
                         RESP(WS-RESP)
               END-EXEC.
               IF WS-RESP NOT = DFHRESP(NORMAL)
                  MOVE ' LINK ZPA00CAH FAILED' TO EM-VARIABLE
