       FILE-ACCESS-0045.
               EXEC CICS STARTBR FILE('KSDSPA31')
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               PERFORM UNTIL WS-RESP NOT = DFHRESP(NORMAL)
                  EXEC CICS READNEXT FILE('KSDSPA31')
                            INTO(KSDSPA31-REC)
