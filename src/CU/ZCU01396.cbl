       FILE-ACCESS-0057.
               EXEC CICS REWRITE FILE('KSDSCU35')
                         FROM(KSDSCU35-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
