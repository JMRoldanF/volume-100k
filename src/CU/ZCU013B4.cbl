       FILE-ACCESS-0063.
               EXEC CICS REWRITE FILE('KSDSCU10')
                         FROM(KSDSCU10-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               EVALUATE WS-RESP
