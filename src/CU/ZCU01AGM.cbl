       FILE-ACCESS-0069.
               EXEC CICS STARTBR FILE('KSDSCU46')
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               PERFORM UNTIL WS-RESP NOT = DFHRESP(NORMAL)
                  EXEC CICS READNEXT FILE('KSDSCU46')
                            INTO(KSDSCU46-REC)
                            RIDFLD(WS-KEY-AREA)
                            RESP(WS-RESP)
