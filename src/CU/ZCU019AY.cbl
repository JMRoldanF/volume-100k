       FILE-ACCESS-0066.
               EXEC CICS WRITE FILE('KSDSCU25')
                         FROM(KSDSCU25-REC)
                         LENGTH(WS-FILE-LEN)
                         RIDFLD(WS-KEY-AREA)
                         RESP(WS-RESP)
               END-EXEC.
               EVALUATE WS-RESP
                  WHEN DFHRESP(NORMAL)
