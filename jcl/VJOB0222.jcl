//DDLIIN39 DD DISP=SHR,DSN=GENAPP.DDLIIN39.DATA
//DDLIOT39 DD DISP=SHR,DSN=GENAPP.DDLIOT39.DATA
//DDLIRP39 DD DISP=SHR,DSN=GENAPP.DDLIRP39.DATA
