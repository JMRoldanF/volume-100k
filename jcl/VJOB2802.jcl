//DDLTIN39 DD DISP=SHR,DSN=GENAPP.DDLTIN39.DATA
//DDLTOT39 DD DISP=SHR,DSN=GENAPP.DDLTOT39.DATA
//DDLTRP39 DD DISP=SHR,DSN=GENAPP.DDLTRP39.DATA
//WORKDS   DD DSN=&&WORK,DISP=(NEW,PASS),UNIT=SYSDA,
