***********************************************************************
* ZIFMAP05 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZIFMAP05 TITLE 'ZIFMAP05 SCREEN LAYOUT'                                 00000040
ZIFMAP05 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               *
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT
ZIFMAP0I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLI*00000090
               CY ENQUIRY -- ALL AMOUNTS IN GBP'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium  00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
         DFHMSD TYPE=FINAL                                              00000160
         END
