         PRINT NOGEN
ZLIMAP05 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT
ZLIMAP0I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX00000060
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000080
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number 00000090
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)

         DFHMSD TYPE=FINAL                                              00000140
         END
