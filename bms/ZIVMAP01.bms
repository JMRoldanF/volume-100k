               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         EJECT                                                          00000070
ZIVMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLI-
                GENAPP VOLUME TEST'
