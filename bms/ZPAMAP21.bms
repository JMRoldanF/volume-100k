ZPAMAP21 TITLE 'ZPAMAP21 SCREEN LAYOUT'                                 00000010
ZPAMAP21 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X00000020
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000030
         EJECT
ZPAMAP2I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='POLICY DETAILX00000060
                                    Page 1 of 1'                        00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000080
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000090
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000120
         DFHMSD TYPE=FINAL                                              00000130
         END
