ZSBMAP01 TITLE 'ZSBMAP01 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN                                                    00000050
ZSBMAP01 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
         EJECT                                                          00000080
ZSBMAP0I DFHMDI SIZE=(24,80)                                            00000090
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custoX00000100
               mer number and press Enter to continue'                  00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
