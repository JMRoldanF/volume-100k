*********************************************************************** 00000010
* ZREMAP10 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZREMAP10 TITLE 'ZREMAP10 SCREEN LAYOUT'
         PRINT NOGEN                                                    00000050
ZREMAP10 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   *00000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZREMAP1I DFHMDI SIZE=(24,80)

         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOL*
               UME TEST'                                                00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000160
ZREMAP10 DFHMSD TYPE=FINAL
         END                                                            00000180
