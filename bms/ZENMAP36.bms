***********************************************************************
* ZENMAP36 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZENMAP36 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         SPACE 1                                                        00000070
ZENMAP3I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000090
                the previous screen, PF3 to exit'
  
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000130
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000140
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000150
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL                                              00000170
         END
