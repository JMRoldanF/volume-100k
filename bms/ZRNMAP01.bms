         PRINT NOGEN
ZRNMAP01 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000020
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
