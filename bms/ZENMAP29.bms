ZENMAP29 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
         EJECT                                                          00000030
ZENMAP2I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOLX00000050
               UME TEST'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000080
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000090

PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium  00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZENMAP29 DFHMSD TYPE=FINAL                                              00000130
         END                                                            00000140
