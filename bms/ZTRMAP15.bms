         PRINT NOGEN
ZTRMAP15 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000020
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000030
