***********************************************************************
* ZCOMAP04 -- generated volume-test mapset                              00000020
***********************************************************************
ZCOMAP04 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               100000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT
ZCOMAP0I DFHMDI SIZE=(24,80)                                            00000070
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='BROKER ENQUIR1
                PF3 Exit'                                               00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000130
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line
ZCOMAP04 DFHMSD TYPE=FINAL
         END                                                            00000160
