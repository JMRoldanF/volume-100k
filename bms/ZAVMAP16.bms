*********************************************************************** 00000010
* ZAVMAP16 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZAVMAP16 TITLE 'ZAVMAP16 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN                                                    00000050
ZAVMAP16 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
         SPACE 1                                                        00000080
ZAVMAP1I DFHMDI SIZE=(24,80)                                            00000090
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX00000100
                                    GENAPP VOLUME TEST'                 00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000130
  
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000150
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000160
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000170
ZAVMAP16 DFHMSD TYPE=FINAL                                              00000180
         END                                                            00000190
