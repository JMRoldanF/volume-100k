***********************************************************************
* ZENMAP26 -- generated volume-test mapset                              00000020
***********************************************************************
ZENMAP26 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         SPACE 3
ZENMAP2I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000080
                the previous screen, PF3 to exit'                       00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line
         DFHMSD TYPE=FINAL                                              00000150
         END
