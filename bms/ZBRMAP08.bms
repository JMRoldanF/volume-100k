*********************************************************************** 00000010
* ZBRMAP08 -- generated volume-test mapset
***********************************************************************
ZBRMAP08 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               1
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT                                                          00000060
ZBRMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 for1
                the previous screen, PF3 to exit'                       00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000130
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL                                              00000150
         END                                                            00000160
