ZAVMAP07 TITLE 'ZAVMAP07 SCREEN LAYOUT'                                 00000040
ZAVMAP07 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   -
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
ZAVMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='POLICY DETAIL-00000080
                                    Page 1 of 1'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000140
ZAVMAP07 DFHMSD TYPE=FINAL                                              00000150
         END
