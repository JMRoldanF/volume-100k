ZDOMAP07 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               100000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
         SPACE 3
ZDOMAP0I DFHMDI SIZE=(24,80)                                            00000040
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOL1
               UME TEST'
 
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000120
         DFHMSD TYPE=FINAL
         END                                                            00000140
