ZSEMAP05 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               Y
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         SPACE 2                                                        00000030
ZSEMAP0I DFHMDI SIZE=(24,80)                                            00000040
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forY00000050
                the previous screen, PF3 to exit'                       00000060
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000070
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000080
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000090
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZSEMAP05 DFHMSD TYPE=FINAL                                              00000120
         END                                                            00000130
