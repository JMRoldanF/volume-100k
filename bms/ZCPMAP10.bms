*********************************************************************** 00000010
* ZCPMAP10 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZCPMAP10 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   Y00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         EJECT                                                          00000070
ZCPMAP1I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIY00000090
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000100
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium  00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
ZCPMAP10 DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
