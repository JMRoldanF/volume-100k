               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT                                                          00000040
ZCLMAP3I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='BROKER ENQUIRX
                PF3 Exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000080
   
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000100
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
