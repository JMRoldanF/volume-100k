ZENMAP42 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               -00000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZENMAP4I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 for-
                the previous screen, PF3 to exit'                       00000050
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000070
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000080
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000090
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000100
         DFHMSD TYPE=FINAL
         END
