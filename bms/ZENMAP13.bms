***********************************************************************
* ZENMAP13 -- generated volume-test mapset
*********************************************************************** 00000030
ZENMAP13 TITLE 'ZENMAP13 SCREEN LAYOUT'
         PRINT NOGEN                                                    00000050
ZENMAP13 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   Y
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
         SPACE 2                                                        00000080
ZENMAP1I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIY00000100
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000130
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000140
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000160
         DFHMSD TYPE=FINAL                                              00000170
         END                                                            00000180
