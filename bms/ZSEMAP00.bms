ZSEMAP00 TITLE 'ZSEMAP00 SCREEN LAYOUT'
         PRINT NOGEN                                                    00000020
ZSEMAP00 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000030
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000040
         EJECT
ZSEMAP0I DFHMDI SIZE=(24,80)                                            00000060
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='BROKER ENQUIRX00000070
                PF3 Exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000090
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000110
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line
         DFHMSD TYPE=FINAL
         END
