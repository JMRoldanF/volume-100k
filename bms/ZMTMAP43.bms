*********************************************************************** 00000010
* ZMTMAP43 -- generated volume-test mapset
*********************************************************************** 00000030
ZMTMAP43 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         SPACE 2                                                        00000060
ZMTMAP4I DFHMDI SIZE=(24,80)                                            00000070
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOLX00000080
               UME TEST'                                                00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000140
         DFHMSD TYPE=FINAL                                              00000150
         END                                                            00000160
