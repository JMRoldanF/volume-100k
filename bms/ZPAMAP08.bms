* ZPAMAP08 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZPAMAP08 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT                                                          00000060
ZPAMAP0I DFHMDI SIZE=(24,80)                                            00000070
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='POLICY DETAILX00000080
                  Page 1 of 1'                                          00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000100
