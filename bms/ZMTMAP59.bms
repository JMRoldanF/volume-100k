*********************************************************************** 00000010
* ZMTMAP59 -- generated volume-test mapset
*********************************************************************** 00000030
ZMTMAP59 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   C00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZMTMAP5I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIC
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000080

HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000100
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000140
         DFHMSD TYPE=FINAL                                              00000150
         END
