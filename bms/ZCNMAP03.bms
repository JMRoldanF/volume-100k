ZCNMAP03 TITLE 'ZCNMAP03 SCREEN LAYOUT'
ZCNMAP03 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   C
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         SPACE 1                                                        00000040
ZCNMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIC
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000120
         DFHMSD TYPE=FINAL                                              00000130
         END
