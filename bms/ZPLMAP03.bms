*********************************************************************** 00000010
* ZPLMAP03 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZPLMAP03 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               100000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         SPACE 2                                                        00000070
ZPLMAP0I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custo100000090
               mer number and press Enter to continue'                  00000100
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium  00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
         DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
