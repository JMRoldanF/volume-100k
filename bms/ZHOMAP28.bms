ZHOMAP28 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   *00000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
         EJECT                                                          00000030
