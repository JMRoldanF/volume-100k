ZBAMAP04 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               100000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT                                                          00000030
ZBAMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOL1
               UME TEST'                                                00000060
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000080
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000110
         DFHMSD TYPE=FINAL                                              00000120
         END
