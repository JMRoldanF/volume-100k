ZSCMAP10 TITLE 'ZSCMAP10 SCREEN LAYOUT'                                 00000010
ZSCMAP10 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000020
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000030
ZSCMAP1I DFHMDI SIZE=(24,80)                                            00000040
      
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custoX00000060
               mer number and press Enter to continue'                  00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000080
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number 00000090
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000110
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000120
ZSCMAP10 DFHMSD TYPE=FINAL                                              00000130
         END                                                            00000140
