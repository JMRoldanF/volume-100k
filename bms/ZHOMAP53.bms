***********************************************************************
* ZHOMAP53 -- generated volume-test mapset                              00000020
***********************************************************************
ZHOMAP53 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               Y
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZHOMAP5I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forY00000070
                the previous screen, PF3 to exit'                       00000080
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000110
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000120
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000130
ZHOMAP53 DFHMSD TYPE=FINAL
         END
