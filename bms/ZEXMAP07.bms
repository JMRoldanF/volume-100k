*********************************************************************** 00000010
* ZEXMAP07 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZEXMAP07 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         SPACE 1                                                        00000070
ZEXMAP0I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000090
                the previous screen, PF3 to exit'                       00000100
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number 00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
ZEXMAP07 DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
