ZMTMAP64 TITLE 'ZMTMAP64 SCREEN LAYOUT'                                 00000010
ZMTMAP64 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               *
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000030
         EJECT                                                          00000040
ZMTMAP6I DFHMDI SIZE=(24,80)                                            00000050
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLI*
               CY ENQUIRY -- ALL AMOUNTS IN GBP'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000100
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL
         END
