         PRINT NOGEN                                                    00000040
ZHOMAP58 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
