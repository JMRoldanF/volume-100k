***********************************************************************
* ZLIMAP02 -- generated volume-test mapset
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZLIMAP02 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   X00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
ZLIMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX00000080
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZLIMAP02 DFHMSD TYPE=FINAL                                              00000150
         END
