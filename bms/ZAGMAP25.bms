*********************************************************************** 00000010
* ZAGMAP25 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZAGMAP25 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               *00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
ZAGMAP2I DFHMDI SIZE=(24,80)                                            00000070
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 for*00000080
                the previous screen, PF3 to exit'                       00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000100
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000130
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000140
         DFHMSD TYPE=FINAL                                              00000150
         END                                                            00000160
