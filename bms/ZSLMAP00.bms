***********************************************************************
* ZSLMAP00 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZSLMAP00 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   -
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         SPACE 2
ZSLMAP0I DFHMDI SIZE=(24,80)                                            00000070
 
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLI-
                                    GENAPP VOLUME TEST'                 00000100
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
