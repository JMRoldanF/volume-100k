ZANMAP01 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000010
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
         SPACE 3                                                        00000030
ZANMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000050
                the previous screen, PF3 to exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium  00000100
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000110
ZANMAP01 DFHMSD TYPE=FINAL                                              00000120
         END                                                            00000130
