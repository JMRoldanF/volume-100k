***********************************************************************
* ZTRMAP16 -- generated volume-test mapset
***********************************************************************
ZTRMAP16 TITLE 'ZTRMAP16 SCREEN LAYOUT'
ZTRMAP16 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   1
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZTRMAP1I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOL1
               UME TEST'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title

CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL
         END
