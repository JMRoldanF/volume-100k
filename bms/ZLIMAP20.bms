         PRINT NOGEN
ZLIMAP20 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT                                                          00000040
ZLIMAP2I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='GENERATED VOLX00000060
               UME TEST'                                                00000070
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
