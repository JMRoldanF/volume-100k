         PRINT NOGEN                                                    00000010
ZANMAP02 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   Y00000020
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000030
         SPACE 2                                                        00000040
