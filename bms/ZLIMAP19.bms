*********************************************************************** 00000010
* ZLIMAP19 -- generated volume-test mapset                              00000020
***********************************************************************
ZLIMAP19 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),  map header   C00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         SPACE 3
ZLIMAP1I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='BROKER ENQUIRC00000080
                                    PF3 Exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL                                              00000150
         END
