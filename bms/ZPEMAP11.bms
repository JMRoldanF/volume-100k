***********************************************************************
* ZPEMAP11 -- generated volume-test mapset                              00000020
***********************************************************************
ZPEMAP11 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT
ZPEMAP1I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custoX00000080
               mer number and press Enter to continue'                  00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000100
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000140
ZPEMAP11 DFHMSD TYPE=FINAL
         END                                                            00000160
