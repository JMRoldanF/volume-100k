ZRNMAP06 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         EJECT                                                          00000070
ZRNMAP0I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX00000090
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000100
