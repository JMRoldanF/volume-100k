*********************************************************************** 00000010
* ZUWMAP12 -- generated volume-test mapset                              00000020
***********************************************************************
ZUWMAP12 TITLE 'ZUWMAP12 SCREEN LAYOUT'
         PRINT NOGEN
ZUWMAP12 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         SPACE 2
ZUWMAP1I DFHMDI SIZE=(24,80)                                            00000090
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000150

ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000170
ZUWMAP12 DFHMSD TYPE=FINAL
         END
