***********************************************************************
* ZCPMAP08 -- generated volume-test mapset                              00000020
***********************************************************************
ZCPMAP08 TITLE 'ZCPMAP08 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN
ZCPMAP08 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
         SPACE 1                                                        00000080
ZCPMAP0I DFHMDI SIZE=(24,80)                                            00000090
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX
                  GENAPP VOLUME TEST'                                   00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number 00000130
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000140
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZCPMAP08 DFHMSD TYPE=FINAL
         END
