ZCLMAP14 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000020
ZCLMAP1I DFHMDI SIZE=(24,80)                                            00000030
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000050
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000060
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000070
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000090

ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000110
         DFHMSD TYPE=FINAL                                              00000120
         END                                                            00000130
