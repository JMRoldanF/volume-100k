*********************************************************************** 00000010
       
* ZCUMAP12 -- generated volume-test mapset                              00000030
*********************************************************************** 00000040
ZCUMAP12 TITLE 'ZCUMAP12 SCREEN LAYOUT'                                 00000050
ZCUMAP12 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               100000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
         SPACE 2                                                        00000080
ZCUMAP1I DFHMDI SIZE=(24,80)                                            00000090
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custo100000100
               mer number and press Enter to continue'                  00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000130
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000140
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000150
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000160
         DFHMSD TYPE=FINAL                                              00000170
         END                                                            00000180
