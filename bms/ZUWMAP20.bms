***********************************************************************
* ZUWMAP20 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZUWMAP20 TITLE 'ZUWMAP20 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN                                                    00000050
ZUWMAP20 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT                                                          00000080
ZUWMAP2I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX
                the previous screen, PF3 to exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000160
         DFHMSD TYPE=FINAL
         END
