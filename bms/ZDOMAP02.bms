***********************************************************************
* ZDOMAP02 -- generated volume-test mapset
***********************************************************************
ZDOMAP02 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               *
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT                                                          00000060
ZDOMAP0I DFHMDI SIZE=(24,80)                                            00000070
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custo*00000080
               mer number and press Enter to continue'

HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
ZDOMAP02 DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
