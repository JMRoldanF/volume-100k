***********************************************************************
* ZMTMAP72 -- generated volume-test mapset
*********************************************************************** 00000030
ZMTMAP72 TITLE 'ZMTMAP72 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN
ZMTMAP72 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
ZMTMAP7I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000090
                the previous screen, PF3 to exit'                       00000100
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number 00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZMTMAP72 DFHMSD TYPE=FINAL                                              00000160
         END
