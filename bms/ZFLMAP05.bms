*********************************************************************** 00000010
* ZFLMAP05 -- generated volume-test mapset
***********************************************************************
ZFLMAP05 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         EJECT
ZFLMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Enter a custoX00000080
               mer number and press Enter to continue'                  00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000100
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)

POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000150
         DFHMSD TYPE=FINAL                                              00000160
         END                                                            00000170
