*********************************************************************** 00000010
* ZMBMAP08 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZMBMAP08 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X00000040
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         SPACE 2                                                        00000060
ZMBMAP0I DFHMDI SIZE=(24,80)                                            00000070
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX00000080
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000090
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000100
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000110
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000120
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000130
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000140
ZMBMAP08 DFHMSD TYPE=FINAL                                              00000150
         END                                                            00000160
