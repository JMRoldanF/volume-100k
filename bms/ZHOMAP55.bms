*********************************************************************** 00000010
* ZHOMAP55 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN
ZHOMAP55 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               *00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         EJECT
ZHOMAP5I DFHMDI SIZE=(24,80)                                            00000080
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 for*00000090
                the previous screen, PF3 to exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number   00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZHOMAP55 DFHMSD TYPE=FINAL                                              00000160
         END
