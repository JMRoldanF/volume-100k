*********************************************************************** 00000010
* ZPAMAP22 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
ZPAMAP22 TITLE 'ZPAMAP22 SCREEN LAYOUT'                                 00000040
         PRINT NOGEN                                                    00000050
ZPAMAP22 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000060
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000070
         EJECT                                                          00000080
ZPAMAP2I DFHMDI SIZE=(24,80)                                            00000090
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000100
                the previous screen, PF3 to exit'                       00000110
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000120
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000130
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000140
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000150
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line      00000160
ZPAMAP22 DFHMSD TYPE=FINAL                                              00000170
         END                                                            00000180
