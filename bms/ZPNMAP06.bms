*********************************************************************** 00000010
* ZPNMAP06 -- generated volume-test mapset
*********************************************************************** 00000030
ZPNMAP06 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000050
         SPACE 3                                                        00000060
ZPNMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX
               CY ENQUIRY -- ALL AMOUNTS IN GBP'
          
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000140
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZPNMAP06 DFHMSD TYPE=FINAL
         END                                                            00000170
