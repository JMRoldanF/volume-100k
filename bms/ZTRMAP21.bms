ZTRMAP21 TITLE 'ZTRMAP21 SCREEN LAYOUT'
         PRINT NOGEN                                                    00000020
ZTRMAP21 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               *00000030
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT
ZTRMAP2I DFHMDI SIZE=(24,80)                                            00000060
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 for*00000070
                the previous screen, PF3 to exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)        screen title    00000090
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)                      00000120
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)                   00000130
ZTRMAP21 DFHMSD TYPE=FINAL
         END                                                            00000150
