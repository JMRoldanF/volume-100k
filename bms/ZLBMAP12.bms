*********************************************************************** 00000010
* ZLBMAP12 -- generated volume-test mapset                              00000020
*********************************************************************** 00000030
         PRINT NOGEN                                                    00000040
ZLBMAP12 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X00000050
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES                      00000060
         SPACE 3
ZLBMAP1I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='Press PF9 forX00000090
                the previous screen, PF3 to exit'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)                        00000110
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)  customer number
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)   error line
ZLBMAP12 DFHMSD TYPE=FINAL
         END                                                            00000170
