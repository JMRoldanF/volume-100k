***********************************************************************
* ZAZMAP08 -- generated volume-test mapset
*********************************************************************** 00000030
ZAZMAP08 TITLE 'ZAZMAP08 SCREEN LAYOUT'
ZAZMAP08 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),               X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
         EJECT                                                          00000070
ZAZMAP0I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX
               CY ENQUIRY -- ALL AMOUNTS IN GBP'                        00000100
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)                  00000120
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)                     00000130
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)

ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
         DFHMSD TYPE=FINAL
         END                                                            00000180
