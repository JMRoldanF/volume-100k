***********************************************************************
* ZCLMAP31 -- generated volume-test mapset
***********************************************************************
ZCLMAP31 TITLE 'ZCLMAP31 SCREEN LAYOUT'
ZCLMAP31 DFHMSD TYPE=MAP,MODE=INOUT,CTRL=(FREEKB,FRSET),TERM=3270-2,   X
               LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
ZCLMAP3I DFHMDI SIZE=(24,80)
         DFHMDF POS=(1,1),LENGTH=60,ATTRB=(PROT),INITIAL='CUSTOMER POLIX
                  GENAPP VOLUME TEST'
HDRTTL   DFHMDF POS=(3,1),LENGTH=40,ATTRB=(PROT)
CUSTNO   DFHMDF POS=(5,20),LENGTH=10,ATTRB=(UNPROT,IC)
POLNO    DFHMDF POS=(6,20),LENGTH=10,ATTRB=(UNPROT)     policy number
PREMIUM  DFHMDF POS=(7,20),LENGTH=9,ATTRB=(UNPROT)      annual premium
ERRMSG   DFHMDF POS=(23,1),LENGTH=70,ATTRB=(PROT,BRT)
ZCLMAP31 DFHMSD TYPE=FINAL
         END
